   <dc:creator>
    <rdf:Seq>
     <rdf:li>Jens Thoemmes</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Telework Agreements</rdf:li>
     <rdf:li xml:lang="en-US">Telework Agreements</rdf:li>
     <rdf:li xml:lang="x-default">Spatial Autonomy and Decent Work in the Hospitality Workforce</rdf:li>
     <rdf:li xml:lang="en-US">Spatial Autonomy and Decent Work in the Hospitality Workforce</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>telework; spatial flexibility; digital transformation; decent work; laboursustainability</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Digital transformation in hospitality has centred on guest-facing and operational technology</rdf:li>
     <rdf:li xml:lang="en-US">Digital transformation in hospitality has centred on guest-facing and operational technology</rdf:li>
     <rdf:li xml:lang="x-default">and most of its jobs cannot be done away from the premises. This paper examines how collective agreements on telework treat such a workforce</rdf:li>
     <rdf:li xml:lang="en-US">and most of its jobs cannot be done away from the premises. This paper examines how collective agreements on telework treat such a workforce</rdf:li>
     <rdf:li xml:lang="x-default">as a decent-work question in the sense of Sustainable Development Goal 8. The evidence is 216 French firm-level telework agreements</rdf:li>
     <rdf:li xml:lang="en-US">as a decent-work question in the sense of Sustainable Development Goal 8. The evidence is 216 French firm-level telework agreements</rdf:li>
     <rdf:li xml:lang="x-default">108 in hospitality and 108 controls matched on signature year</rdf:li>
     <rdf:li xml:lang="en-US">108 in hospitality and 108 controls matched on signature year</rdf:li>
     <rdf:li xml:lang="x-default">of which 179 contain an operative rule. Hospitality and control agreements share one eligibility template. In both</rdf:li>
     <rdf:li xml:lang="en-US">of which 179 contain an operative rule. Hospitality and control agreements share one eligibility template. In both</rdf:li>
     <rdf:li xml:lang="x-default">about four in five exclude the operational core by named staff categories or a task-compatibility test (78.3 and 81.6 per cent)</rdf:li>
     <rdf:li xml:lang="en-US">about four in five exclude the operational core by named staff categories or a task-compatibility test (78.3 and 81.6 per cent)</rdf:li>
     <rdf:li xml:lang="x-default">and almost none compensates excluded staff (0 of 92 and 2 of 87). The template is place-blind</rdf:li>
     <rdf:li xml:lang="en-US">and almost none compensates excluded staff (0 of 92 and 2 of 87). The template is place-blind</rdf:li>
     <rdf:li xml:lang="x-default">so its reach depends on the workforce it governs. In 49.5 per cent of hospitality agreements and 23.0 per cent of controls</rdf:li>
     <rdf:li xml:lang="en-US">so its reach depends on the workforce it governs. In 49.5 per cent of hospitality agreements and 23.0 per cent of controls</rdf:li>
     <rdf:li xml:lang="x-default">fewer than one-third of employees in the signing entityâ€™s sector hold teleworkable jobs. In Germany in 2025</rdf:li>
     <rdf:li xml:lang="en-US">fewer than one-third of employees in the signing entityâ€™s sector hold teleworkable jobs. In Germany in 2025</rdf:li>
     <rdf:li xml:lang="x-default">hospitality had the lowest home-office share of fifteen activities</rdf:li>
     <rdf:li xml:lang="en-US">hospitality had the lowest home-office share of fifteen activities</rdf:li>
     <rdf:li xml:lang="x-default">below the feasibility of remote work in the sector. The institutional finding is the shared template without counterparts; effects on recruitment</rdf:li>
     <rdf:li xml:lang="en-US">below the feasibility of remote work in the sector. The institutional finding is the shared template without counterparts; effects on recruitment</rdf:li>
     <rdf:li xml:lang="x-default">retention and labour sustainability are implications to be tested.</rdf:li>
     <rdf:li xml:lang="en-US">retention and labour sustainability are implications to be tested.</rdf:li>
    </rdf:Alt>
   </dc:description>
